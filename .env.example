# Copy this file to .env and adjust as needed.

# SQLite (default, zero-install, single computer / small lab):
DATABASE_URL=sqlite:///./data/rbcmas.db

# PostgreSQL (institutional / multi-user server) example:
# DATABASE_URL=postgresql+psycopg2://rbcmas_user:changeme@localhost:5432/rbcmas

# Random secret used to sign session cookies. Generate a real one for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-hex-string

# Session cookie lifetime, in hours
SESSION_HOURS=12

# Default expiry-warning thresholds, in days (can also be changed in Administration > Settings)
EXPIRY_WARNING_DAYS_1=30
EXPIRY_WARNING_DAYS_2=60
EXPIRY_WARNING_DAYS_3=90

# Dead-stock detection window, in days
DEAD_STOCK_DAYS=365

# Reconciliation variance tolerance before a reason is mandatory (percent)
VARIANCE_TOLERANCE_PERCENT=1.0

# Set to true only for local development
DEBUG=false
